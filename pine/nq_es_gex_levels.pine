// This Pine Script(R) source is part of the gexsys project. Analytical indicator only - it places no orders.
//@version=6
indicator("GEX PRO - NQ / ES", shorttitle = "GEX PRO", overlay = true,
     max_lines_count = 200, max_labels_count = 200, max_boxes_count = 300)

// =====================================================================================================
// GEX PRO draws options levels computed by the gexsys service (open START.bat, then the website at
// http://127.0.0.1:8765) and pasted into "Levels payload". Pine cannot download data, so the levels
// change when you paste a new update (every hour on the hour). Levels come from index + ETF options
// (SPX + SPY for ES, NDX + QQQ for NQ), are expressed in index prices and are mapped live to this futures
// chart. Levels are model estimates for the current session; nothing is back-plotted.
// =====================================================================================================

// ---------- 1 - Data
G1 = "1 - Data"
payload = input.text_area("", "Levels payload", group = G1,
     tooltip = "On the GEX website click 'Copy for TradingView', then click here, Ctrl+A, Ctrl+V, OK. The same paste works on NQ and ES charts.")
mapMode = input.string("Live reference", "Price mapping", options = ["Live reference", "Snapshot factor", "None"], group = G1,
     tooltip = "Live reference (recommended): converts index prices with this chart vs. the live index (NASDAQ:NDX / SP:SPX); held from the last bar when the index is closed.\nSnapshot factor: the service's conversion factor.\nNone: draw the index prices unconverted.")

// Line style and thickness are picked from drawn previews in settings (──── ╌╌╌╌ ┈┈┈┈, ─── ━━━ ▬▬▬ ███)
pxOf(string pick) =>
    pick == "███" ? 4 : pick == "▬▬▬" ? 3 : pick == "━━━" ? 2 : 1

// ---------- 2 - Key levels: one clean row each, on/off + colour swatch
G2 = "2 - Key levels"
showZG   = input.bool(true, "Zero gamma", inline = "zg", group = G2)
cZG      = input.color(#f0b429, "", inline = "zg", group = G2, tooltip = "Estimated price where modeled dealer gamma flips sign. Line style and width next to the colour.")
styZG = input.string("╌╌╌╌", "", options = ["────", "╌╌╌╌", "┈┈┈┈"], inline = "zg", group = G2)
wZGPick = input.string("───", "", options = ["───", "━━━", "▬▬▬", "███"], inline = "zg", group = G2)
wZG = pxOf(wZGPick)
showCW   = input.bool(true, "Call wall", inline = "cw", group = G2)
cPos     = input.color(#22c55e, "", inline = "cw", group = G2, tooltip = "Strike above price with the most call gamma. Also the colour of positive-gamma levels and profile bars.")
styCW = input.string("────", "", options = ["────", "╌╌╌╌", "┈┈┈┈"], inline = "cw", group = G2)
wCWPick = input.string("───", "", options = ["───", "━━━", "▬▬▬", "███"], inline = "cw", group = G2)
wCW = pxOf(wCWPick)
showPW   = input.bool(true, "Put wall", inline = "pw", group = G2)
cNeg     = input.color(#ef4444, "", inline = "pw", group = G2, tooltip = "Strike below price with the most put gamma. Also the colour of negative-gamma levels and profile bars.")
styPW = input.string("────", "", options = ["────", "╌╌╌╌", "┈┈┈┈"], inline = "pw", group = G2)
wPWPick = input.string("───", "", options = ["───", "━━━", "▬▬▬", "███"], inline = "pw", group = G2)
wPW = pxOf(wPWPick)
showAG   = input.bool(true, "Absolute gamma", inline = "ag", group = G2)
cAG      = input.color(#a78bfa, "", inline = "ag", group = G2, tooltip = "Strike with the most TOTAL gamma (calls + puts). Often acts like a magnet. Doesn't depend on any dealer-positioning assumption.")
styAG = input.string("┈┈┈┈", "", options = ["────", "╌╌╌╌", "┈┈┈┈"], inline = "ag", group = G2)
wAGPick = input.string("───", "", options = ["───", "━━━", "▬▬▬", "███"], inline = "ag", group = G2)
wAG = pxOf(wAGPick)
showRank = input.bool(true, "Ranked levels (C1-C7, P1-P7, Ab1-Ab3)", inline = "rk", group = G2,
     tooltip = "The strongest price bands near price: C = most positive net GEX, P = most negative net GEX, Ab = most total gamma (call / put / absolute-gamma colours). 1 = strongest. Each line's opacity and its tag's bar show its share of gamma; ranks 1-2 use the style picked here, weaker ranks are dotted.")
styRank = input.string("────", "", options = ["────", "╌╌╌╌", "┈┈┈┈"], inline = "rk", group = G2)
wRankPick = input.string("───", "", options = ["───", "━━━", "▬▬▬", "███"], inline = "rk", group = G2)
wRank = pxOf(wRankPick)
rankSrc = input.string("First expiry: auto", "Ranked from", options = ["First expiry: auto", "First expiry: ETF only", "First expiry: index + ETF", "All expirations (45 days)"], group = G2,
     tooltip = "First expiry = today's expiring options (or the next expiry when none expire today): their gamma sits close to price, so many nearby levels for intraday trading.\nauto (recommended): whichever chain holds most of that gamma - for NQ usually QQQ alone (levels on QQQ's own strikes, about 41 NQ points apart), for ES usually SPX with SPY.\nETF only: QQQ / SPY strikes alone.\nindex + ETF: both chains on the index's strike grid.\nAll expirations: every expiry out to 45 days; fewer, bigger levels further out.")
rankC = input.int(7, "Levels: C", minval = 0, maxval = 7, inline = "rn", group = G2)
rankP = input.int(7, "P", minval = 0, maxval = 7, inline = "rn", group = G2)
rankA = input.int(3, "Ab", minval = 0, maxval = 3, inline = "rn", group = G2, tooltip = "How many call, put and absolute-gamma levels to draw (strongest first).")
showMax  = input.bool(false, "Largest +/- GEX and concentrations", inline = "mx", group = G2, tooltip = "Strikes with the most positive / negative gamma, plus the extra concentrations below, in the call / put colours.")
styMax = input.string("┈┈┈┈", "", options = ["────", "╌╌╌╌", "┈┈┈┈"], inline = "mx", group = G2)
wMaxPick = input.string("───", "", options = ["───", "━━━", "▬▬▬", "███"], inline = "mx", group = G2)
wMax = pxOf(wMaxPick)
nConc    = input.int(0, "Other concentrations", minval = 0, maxval = 6, inline = "cc", group = G2)
minShare = input.float(5.0, "min %", minval = 0, step = 0.5, inline = "cc", group = G2,
     tooltip = "Extra big-gamma strikes, labeled +G / -G with their share of total exposure. 0 = off.")

// ---------- 3 - More levels: same clean rows
G3 = "3 - More levels"
show0   = input.bool(true, "0DTE zero gamma and walls", inline = "z0", group = G3,
     tooltip = "The same levels from today's expiring options only (\"next MM-DD\" when nothing expires today), in lighter key-level colours.")
sty0 = input.string("────", "", options = ["────", "╌╌╌╌", "┈┈┈┈"], inline = "z0", group = G3)
w0Pick = input.string("───", "", options = ["───", "━━━", "▬▬▬", "███"], inline = "z0", group = G3)
w0 = pxOf(w0Pick)
showVol = input.bool(false, "Volume walls", inline = "vo", group = G3)
cVol    = input.color(#2dd4bf, "", inline = "vo", group = G3, tooltip = "Strikes with the most calls / puts traded today. Moves during the session.")
styVol = input.string("╌╌╌╌", "", options = ["────", "╌╌╌╌", "┈┈┈┈"], inline = "vo", group = G3)
wVolPick = input.string("───", "", options = ["───", "━━━", "▬▬▬", "███"], inline = "vo", group = G3)
wVol = pxOf(wVolPick)
showOI  = input.bool(false, "OI walls", inline = "oi", group = G3)
cOI     = input.color(#9085e9, "", inline = "oi", group = G3, tooltip = "Strikes with the most open calls / puts as of yesterday's close.")
styOI = input.string("┈┈┈┈", "", options = ["────", "╌╌╌╌", "┈┈┈┈"], inline = "oi", group = G3)
wOIPick = input.string("───", "", options = ["───", "━━━", "▬▬▬", "███"], inline = "oi", group = G3)
wOI = pxOf(wOIPick)
showMP  = input.bool(false, "Max pain", inline = "mp", group = G3)
cMP     = input.color(#c98500, "", inline = "mp", group = G3, tooltip = "Price where option holders lose the most at expiration.")
styMP = input.string("┈┈┈┈", "", options = ["────", "╌╌╌╌", "┈┈┈┈"], inline = "mp", group = G3)
wMPPick = input.string("───", "", options = ["───", "━━━", "▬▬▬", "███"], inline = "mp", group = G3)
wMP = pxOf(wMPPick)
mpCount = input.string("Nearest", "Max pain expirations", options = ["Nearest", "Nearest + next"], group = G3)
showEM  = input.bool(true, "Expected move", inline = "em", group = G3)
cEM     = input.color(#8b95a5, "", inline = "em", group = G3, tooltip = "1 standard-deviation range implied by options, from the previous close (weekly: lighter).")
styEM = input.string("╌╌╌╌", "", options = ["────", "╌╌╌╌", "┈┈┈┈"], inline = "em", group = G3)
wEMPick = input.string("───", "", options = ["───", "━━━", "▬▬▬", "███"], inline = "em", group = G3)
wEM = pxOf(wEMPick)
emMode  = input.string("Daily", "Expected move range", options = ["Daily", "Weekly", "Daily + weekly"], group = G3)

// ---------- 4 - Lines & labels (shared by every level)
G4 = "4 - Lines & labels"
extent   = input.string("Across the chart, end at price", "Lines", options = ["Across the chart, end at price", "From session open", "Full chart", "Right of price"], group = G4,
     tooltip = "Across the chart, end at price: each level runs across the chart's history and stops at the current bar, so nothing is drawn over the space right of price except the tags.")
lblMode  = input.string("Tags + hover info", "Labels", options = ["Tags + hover info", "Short", "Full", "Off"], inline = "lb", group = G4,
     tooltip = "Tags + hover info: a short tag right of price (C1, P1, Ab1, ZG...) with a strength bar; hover the tag for that level's analysis.\nShort: ZG, CW, PW, +GEX, -GEX, 0D ZG, VOL C, MP 10-21, EM+...\nFull: Zero gamma, Call wall, ...")
lblSize  = input.string("Small", "", options = ["Tiny", "Small", "Normal"], inline = "lb", group = G4)
lblBg    = input.bool(true, "Label background", inline = "lb2", group = G4)
lblOff   = input.int(6, "offset (bars)", minval = 0, maxval = 200, inline = "lb2", group = G4, tooltip = "Used when the GEX profile is off; with the profile on, labels sit just right of it.")
confPct  = input.float(0.10, "Confluence within (%)", minval = 0.01, step = 0.01, group = G4,
     tooltip = "Tags + hover info: levels closer than this (% of price) count as one confluence zone in the hover text.")
emFill   = input.bool(false, "Shade daily expected-move band", group = G4, tooltip = "Faint fill between today's expected high and low (uses the expected-move colour).")
zoneShade = input.bool(true, "Shade gamma zones next to price", group = G4,
     tooltip = "A narrow column right of the last bar: green = positive gamma zone (gamma flip to C1) and its extension (C1 to the next call level up), red = negative gamma zone (P1 to the gamma flip) and its extension (P1 to the next put level down). Hover a tag for the zone it sits in.")
regimeBg = input.bool(false, "Tint today's session by gamma side", group = G4,
     tooltip = "Faint blue while price is above zero gamma (modeled positive gamma: calmer, mean-reverting), faint orange below it (negative gamma: bigger, trending moves). Today's session only.")

// ---------- 5 - GEX profile
G5 = "5 - GEX profile"
showProf   = input.bool(false, "Show profile", inline = "pf", group = G5,
     tooltip = "Gamma exposure by price, drawn right of the last bar. Blue extends right (positive), orange extends left (negative).")
profSrc    = input.string("First source", "", options = ["First source", "Second source"], inline = "pf", group = G5)
profWidth  = input.int(40, "Width", minval = 10, maxval = 200, inline = "pw", group = G5)
profOffset = input.int(3, "gap", minval = 1, maxval = 100, inline = "pw", group = G5)
profOpac   = input.int(65, "Opacity %", minval = 10, maxval = 100, group = G5)

// ---------- 6 - Info panel
G6 = "6 - Info panel"
showTab   = input.bool(true, "Show panel", inline = "t1", group = G6, tooltip = "Off hides the panel completely; levels stay on the chart.")
tabDetail = input.string("Compact", "", options = ["Minimal", "Compact", "Full"], inline = "t1", group = G6,
     tooltip = "Minimal: regime, zero gamma, data age.\nCompact: + call and put walls.\nFull: + net GEX, +/- GEX strikes, 0DTE levels, volume walls, max pain, expected move, mapping.")
tabPos    = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], inline = "t2", group = G6)
tabSize   = input.string("Small", "", options = ["Tiny", "Small", "Normal"], inline = "t2", group = G6)

// ---------- 7 - Alerts (real-time bars; create an alert with "Any alert() function call")
G7 = "7 - Alerts"
alApproach      = input.bool(true, "Approaching a key level", inline = "a1", group = G7)
alApproachTicks = input.int(20, "within ticks", minval = 1, inline = "a1", group = G7)
alCross         = input.bool(true, "Wall cross", inline = "a2", group = G7)
alZG            = input.bool(true, "Zero-gamma cross", inline = "a2", group = G7)
alStale         = input.bool(true, "Stale update", inline = "a3", group = G7)
alCooldownMin   = input.int(15, "cooldown min", minval = 0, inline = "a3", group = G7)

// ---------- 8 - Advanced
G8 = "8 - Advanced"
extFrom     = input.string("First source", "More levels from", options = ["First source", "Both sources"], group = G8,
     tooltip = "Only matters when a paste holds two sources for this market.")
provFilter  = input.string("", "Only this source", group = G8, tooltip = "Blank = all sources in the paste (e.g. CBOE).")
refOverride = input.string("", "Reference symbol override", group = G8, tooltip = "Blank = the symbol in the paste (NASDAQ:NDX, SP:SPX, ...).")
staleMin    = input.int(90, "Stale after (minutes)", minval = 1, group = G8, tooltip = "Default suits the hourly update schedule (one missed update plus slack).")
maxDistPct  = input.float(8.0, "Ignore levels farther than (%)", minval = 1, group = G8,
     tooltip = "Safety check: a level this far from price means the mapping is wrong; it is not drawn.")
manualTxt   = input.string("", "Manual levels", group = G8, tooltip = "Your own chart prices: price:name, comma separated. Example: 29900:Weekly high, 29500:Gap")

// =====================================================================================================
// Payload parsing (grammar of gexsys/export.py: GEX1;key=value;...;END, payloads joined by "|")
// =====================================================================================================
type Snap
    string prov = ""
    string mkt = ""
    string src = ""
    string etf = ""
    string kind = ""
    string tv = ""
    string mapm = ""
    float  fac = na
    float  off = 0.0
    float  ts = na
    float  ref = na
    string q = ""
    string oi = ""
    string gk = ""
    string model = ""
    string unit = ""
    float  net = na
    string reg = ""
    string st = ""
    float  zg = na
    string zgs = ""
    float  cw = na
    float  pw = na
    float  mp = na
    float  mn = na
    float  em = na
    string bk = ""
    float  dzg = na
    string preg = ""
    string lv = ""
    string x0 = ""
    float  z0 = na
    float  c0 = na
    float  p0 = na
    float  vc = na
    float  vp = na
    float  oc = na
    float  op = na
    string xp = ""
    float  ema = na
    float  emd = na
    float  emw = na
    string emx = ""
    string prof = ""
    float  ag = na
    float  vxm = na
    float  chm = na
    string rk = ""
    string rk0 = ""
    string rk0e = ""
    float  g0e = na
    string x0d = ""
    bool   complete = false

strOf(map<string, string> m, string k) =>
    map.contains(m, k) ? map.get(m, k) : ""

numOf(map<string, string> m, string k) =>
    string v = strOf(m, k)
    v == "" ? na : str.tonumber(v)

parseOne(string txt) =>
    map<string, string> m = map.new<string, string>()
    array<string> toks = str.split(str.trim(txt), ";")
    bool ok = array.size(toks) > 1 and array.get(toks, 0) == "GEX1"
    Snap s = na
    if ok
        for t in toks
            int p = str.pos(t, "=")
            if not na(p) and p > 0
                map.put(m, str.substring(t, 0, p), str.substring(t, p + 1))
        s := Snap.new(prov = strOf(m, "prov"), mkt = strOf(m, "mkt"), src = strOf(m, "src"), etf = strOf(m, "etf"), kind = strOf(m, "kind"),
             tv = strOf(m, "tv"), mapm = strOf(m, "map"), fac = numOf(m, "fac"), off = nz(numOf(m, "off")),
             ts = numOf(m, "ts"), ref = numOf(m, "ref"), q = strOf(m, "q"), oi = strOf(m, "oi"), gk = strOf(m, "gk"),
             model = strOf(m, "model"), unit = strOf(m, "unit"), net = numOf(m, "netb"), reg = strOf(m, "reg"),
             st = strOf(m, "st"), zg = numOf(m, "zg"), zgs = strOf(m, "zgs"), cw = numOf(m, "cw"), pw = numOf(m, "pw"),
             mp = numOf(m, "mp"), mn = numOf(m, "mn"), em = numOf(m, "em"), bk = strOf(m, "bk"),
             dzg = numOf(m, "dzg"), preg = strOf(m, "preg"), lv = strOf(m, "L"),
             x0 = strOf(m, "x0"), z0 = numOf(m, "z0"), c0 = numOf(m, "c0"), p0 = numOf(m, "p0"),
             vc = numOf(m, "vc"), vp = numOf(m, "vp"), oc = numOf(m, "oc"), op = numOf(m, "op"), xp = strOf(m, "xp"),
             ema = numOf(m, "ema"), emd = numOf(m, "emd"), emw = numOf(m, "emw"), emx = strOf(m, "emx"),
             prof = strOf(m, "P"), ag = numOf(m, "ag"), vxm = numOf(m, "vxm"), chm = numOf(m, "chm"), rk = strOf(m, "R"), rk0 = strOf(m, "R0"), rk0e = strOf(m, "R0e"), g0e = numOf(m, "g0e"), x0d = strOf(m, "x0d"), complete = str.trim(array.get(toks, array.size(toks) - 1)) == "END")
    s

fam(string s) =>
    s == "NQ" or s == "MNQ" ? "NQ" : s == "ES" or s == "MES" ? "ES" : s

chartFam = fam(syminfo.root)

// Select (once) the first two payloads for this chart's market
var Snap sA = na
var Snap sB = na
var int nParsed = 0
var string otherMkts = ""
if barstate.isfirst
    for chunk in str.split(payload, "|")
        Snap s = parseOne(chunk)
        if not na(s)
            nParsed += 1
            bool provOK = provFilter == "" or s.prov == str.upper(str.trim(provFilter))
            bool mktOK = fam(s.mkt) == chartFam or (mapMode == "None" and syminfo.ticker == s.src)
            if mktOK and provOK
                if na(sA)
                    sA := s
                else if na(sB)
                    sB := s
            else if not mktOK and not str.contains(otherMkts, s.mkt)
                otherMkts += (otherMkts == "" ? "" : ",") + s.mkt
hasA = not na(sA)
hasB = not na(sB)

// =====================================================================================================
// Mapping (one live reference per source slot)
// =====================================================================================================
string symA = syminfo.tickerid
string symB = syminfo.tickerid
if hasA
    symA := refOverride != "" ? refOverride : sA.tv != "" ? sA.tv : syminfo.tickerid
if hasB
    symB := refOverride != "" ? refOverride : sB.tv != "" ? sB.tv : syminfo.tickerid
refCA = request.security(symA, timeframe.period, close, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
refCB = request.security(symB, timeframe.period, close, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
var float lfA = na
var float loA = na
var float lfB = na
var float loB = na
if not na(refCA) and refCA > 0
    lfA := close / refCA
    loA := close - refCA
if not na(refCB) and refCB > 0
    lfB := close / refCB
    loB := close - refCB

mapInfo(Snap s, float lf, float lo, float refNow, string sym) =>
    float f = na
    float o = 0.0
    string st = "n/a"
    if not na(s)
        if s.mapm == "identity"
            f := 1.0
            st := "identity (futures options)"
        else if s.mapm == "calendar_offset"
            f := 1.0
            o := s.off
            st := "calendar offset"
        else if mapMode == "None"
            f := 1.0
            st := "none (index prices)"
        else if mapMode == "Snapshot factor"
            if not na(s.fac) and s.fac > 0
                f := s.mapm == "ratio" ? s.fac : 1.0
                o := s.mapm == "offset" ? s.off : 0.0
                st := "snapshot " + s.mapm
            else
                st := "UNAVAILABLE (no snapshot factor)"
        else
            if not na(lf)
                f := s.mapm == "ratio" ? lf : 1.0
                o := s.mapm == "offset" ? lo : 0.0
                st := (na(refNow) ? "held " : "live ") + s.mapm + " vs " + sym
            else if not na(s.fac) and s.fac > 0
                f := s.mapm == "ratio" ? s.fac : 1.0
                o := s.mapm == "offset" ? s.off : 0.0
                st := "snapshot (no " + sym + " data)"
            else
                st := "UNAVAILABLE (no " + sym + " data)"
    [f, o, st]

[facA, offA, mstA] = mapInfo(sA, lfA, loA, refCA, symA)
[facB, offB, mstB] = mapInfo(sB, lfB, loB, refCB, symB)

mapP(float p, float f, float o) =>
    na(p) or na(f) ? na : math.round_to_mintick(p * f + o)

sane(float p) =>
    na(p) ? true : math.abs(p - close) / close * 100.0 <= maxDistPct

slotOK(Snap s, float f, float o) =>
    bool ok = false
    if not na(s)
        ok := not na(f) and s.st != "UNAVAILABLE" and sane(mapP(s.zg, f, o)) and sane(mapP(s.cw, f, o)) and sane(mapP(s.pw, f, o)) and sane(mapP(s.mp, f, o)) and sane(mapP(s.mn, f, o))
    ok

okA = slotOK(sA, facA, offA)
okB = slotOK(sB, facB, offB)

ageOf(Snap s) =>
    float a = na
    if not na(s)
        if not na(s.ts)
            a := (timenow - s.ts) / 60000.0
    a
staleOf(Snap s) =>
    float a = ageOf(s)
    na(a) or a > staleMin

// Primary (alerts, data window): first drawable source. If-blocks so a missing slot's fields are never read.
float zgF = na
float cwF = na
float pwF = na
if okA
    zgF := mapP(sA.zg, facA, offA)
    cwF := mapP(sA.cw, facA, offA)
    pwF := mapP(sA.pw, facA, offA)
else if okB
    zgF := mapP(sB.zg, facB, offB)
    cwF := mapP(sB.cw, facB, offB)
    pwF := mapP(sB.pw, facB, offB)

// =====================================================================================================
// Drawing (last bar only; levels are a current snapshot, not history)
// =====================================================================================================
var array<line>   gLines  = array.new<line>()
var array<label>  gLabels = array.new<label>()
var array<float>  gPrices = array.new<float>()
var array<string> gBodies = array.new<string>()
var array<box>    gBoxes  = array.new<box>()
// "Tags + hover info": one tag per price, filled while drawing and rendered at the end (confluence needs every level)
var array<float>  tgP    = array.new<float>()
var array<string> tgName = array.new<string>()
var array<string> tgFull = array.new<string>()
var array<color>  tgCol  = array.new<color>()
var array<float>  tgStr  = array.new<float>()
// ranked call / put levels (chart prices, rank order) and the gamma flip they are measured from: the zones
var array<float>  zC = array.new<float>()
var array<float>  zP = array.new<float>()
var float zFlip = na
tagMode = lblMode == "Tags + hover info"

// Time of the current session's first bar (exchange day), where "From session open" lines start.
// Lines are placed by TIME (xloc.bar_time): a bar-index start hundreds of bars back makes Pine look up
// that bar's history, which overflows the history buffer on low timeframes (e.g. 1-minute charts).
var int sessStartTime = time
var int firstTime = time                    // the chart's first loaded bar: where "across the chart" lines start
if timeframe.change("D")
    sessStartTime := time

lnStyle(string s) =>
    s == "╌╌╌╌" or s == "Dashed" ? line.style_dashed : s == "┈┈┈┈" or s == "Dotted" ? line.style_dotted : line.style_solid
lSz = lblSize == "Tiny" ? size.tiny : lblSize == "Small" ? size.small : size.normal
lblX = showProf ? profOffset + profWidth + 2 : lblOff
lblBgCol = lblBg ? color.new(#0b0e13, 25) : color.new(#0b0e13, 100)
twoSrc = okA and okB

// A level's short and full name, packed as "CW|Call wall"; drawLevel picks what it shows
nm(string short, string full) =>
    short + "|" + full

fmtPx(float p) =>
    str.tostring(p, "#,##0.00")

clearAll() =>
    for l in gLines
        line.delete(l)
    for lb in gLabels
        label.delete(lb)
    for b in gBoxes
        box.delete(b)
    array.clear(gLines)
    array.clear(gLabels)
    array.clear(gPrices)
    array.clear(gBodies)
    array.clear(gBoxes)
    array.clear(tgP)
    array.clear(tgName)
    array.clear(tgFull)
    array.clear(tgCol)
    array.clear(tgStr)
    array.clear(zC)
    array.clear(zP)

// One line per price; another level at the same price joins the label: "CW · +GEX  29,883.25".
// name is "short|full" (from nm) or plain text; strength 0-1 sizes the tag's bar, info adds a hover line.
drawLevel(float p, string name, string tag, color col, int width, string style, float strength = na, string info = "", string ico = "•") =>
    if not na(p) and sane(p)
        array<string> nf = str.split(name, "|")
        string short = array.get(nf, 0)
        string full = array.size(nf) > 1 ? array.get(nf, 1) : short
        string item = (lblMode == "Full" ? full : short) + tag
        string fullItem = ico + " " + full + tag + (info != "" ? " — " + info : "")
        int idx = -1
        for [i, q] in gPrices
            if math.abs(q - p) < syminfo.mintick / 2
                idx := i
        if idx >= 0
            string body = array.get(gBodies, idx)
            if not str.contains(body, item)
                body := body + " · " + item
                array.set(gBodies, idx, body)
                label lb = array.get(gLabels, idx)
                if not na(lb)
                    label.set_text(lb, body + "  " + fmtPx(p))
                if tagMode
                    array.set(tgName, idx, array.get(tgName, idx) + "·" + short)
                    array.set(tgFull, idx, array.get(tgFull, idx) + "\n" + fullItem)
                    if not na(strength)
                        array.set(tgStr, idx, math.max(nz(array.get(tgStr, idx)), strength))
        else
            bool toPrice = extent == "Across the chart, end at price"
            int t1 = extent == "Right of price" ? time : extent == "Full chart" or toPrice ? math.min(firstTime, time - 1) : math.min(sessStartTime, time - 1)
            int t2 = extent == "Right of price" ? time + 1 : time      // t2 > t1 gives the line a direction to extend
            array.push(gPrices, p)
            array.push(gBodies, item)
            array.push(gLines, line.new(t1, p, t2, p, xloc = xloc.bar_time, extend = extent == "Full chart" ? extend.both : toPrice ? extend.none : extend.right,
                 color = col, width = width, style = style))
            array.push(gLabels, lblMode != "Off" and not tagMode ? label.new(bar_index + lblX, p, item + "  " + fmtPx(p), style = label.style_label_left,
                 color = lblBgCol, textcolor = col, size = lSz, textalign = text.align_left) : label(na))
            array.push(tgP, p)
            array.push(tgName, short)
            array.push(tgFull, fullItem)
            array.push(tgCol, col)
            array.push(tgStr, strength)
    p

// Which ranking the tags use: [tokens, what they cover, first expiry?, ETF alone?]
rankedOf(Snap s) =>
    bool hasI = s.rk0 != ""
    bool hasE = s.rk0e != ""
    bool first = rankSrc != "All expirations (45 days)" and (hasI or hasE)
    bool etf = first and (rankSrc == "First expiry: ETF only" ? hasE : rankSrc == "First expiry: index + ETF" ? not hasI : hasE and (nz(s.g0e) >= 50 or not hasI))
    string what = not first ? "all expiries'" : etf ? s.etf + "'s own (this expiry)" : "this expiry's"
    [first ? (etf ? s.rk0e : s.rk0) : s.rk, what, first, etf]

ordinal(int k) =>
    k == 1 ? "1st" : k == 2 ? "2nd" : k == 3 ? "3rd" : str.tostring(k) + "th"

tagOf(Snap s) =>
    (twoSrc ? " " + s.prov : "") + (staleOf(s) ? " STALE" : "")

drawKey(Snap s, float f, float o, bool isSecond) =>
    string tag = tagOf(s)
    int tr = isSecond ? 40 : 0
    if showZG
        drawLevel(mapP(s.zg, f, o), nm("ZG", "Zero gamma"), tag, color.new(cZG, tr), wZG, lnStyle(styZG), na, "all-expiry gamma flip (estimate): above it dealer hedging calms moves, below it adds to them", "🟡")
    if showCW
        drawLevel(mapP(s.cw, f, o), nm("CW", "Call wall"), tag, color.new(cPos, tr), wCW, isSecond ? line.style_dashed : lnStyle(styCW), na, "the strike above price with the most call gamma, all expiries", "🟢")
    if showPW
        drawLevel(mapP(s.pw, f, o), nm("PW", "Put wall"), tag, color.new(cNeg, tr), wPW, isSecond ? line.style_dashed : lnStyle(styPW), na, "the strike below price with the most put gamma, all expiries", "🔴")
    if showAG
        drawLevel(mapP(s.ag, f, o), nm("AG", "Abs gamma"), tag, color.new(cAG, tr), wAG, lnStyle(styAG), na, "the strike with the most total gamma (calls + puts), all expiries", "🟣")
    if showMax
        drawLevel(mapP(s.mp, f, o), nm("+GEX", "Largest +GEX"), tag, color.new(cPos, tr), wMax, lnStyle(styMax))
        drawLevel(mapP(s.mn, f, o), nm("-GEX", "Largest -GEX"), tag, color.new(cNeg, tr), wMax, lnStyle(styMax))
    // ranked levels: the first expiry's bands (default) or all expiries'; ranks 1-2 in the picked style, weaker dotted
    [rks, scope, first, etfOnly] = rankedOf(s)
    if showRank and rks != ""
        float top = 0.0
        for item in str.split(rks, ",")
            array<string> pr = str.split(str.substring(item, 1), ":")
            if array.size(pr) == 2
                top := math.max(top, nz(str.tonumber(array.get(pr, 1))))
        int nC = 0
        int nP = 0
        int nA = 0
        for item in str.split(rks, ",")
            string kind = str.substring(item, 0, 1)
            array<string> pr = str.split(str.substring(item, 1), ":")
            if array.size(pr) == 2
                float rp = mapP(str.tonumber(array.get(pr, 0)), f, o)
                float sh = str.tonumber(array.get(pr, 1))
                float stren = top > 0 and not na(sh) ? sh / top : na
                string shTxt = " (" + str.tostring(sh, "0.0") + "% of " + scope + " gamma)"
                if kind == "C" and nC < rankC
                    nC += 1
                    string r = str.tostring(nC)
                    if not isSecond and sane(rp)
                        array.push(zC, rp)
                    drawLevel(rp, "C" + r + "|Call level #" + r, tag, color.new(cPos, tr), wRank, nC <= 2 ? lnStyle(styRank) : line.style_dotted, stren,
                         (nC == 1 ? "highest positive net GEX: the main call-side concentration. If price moves beyond it, the next call level may take over" : ordinal(nC) + " highest positive net GEX") + shTxt, "🟢")
                else if kind == "P" and nP < rankP
                    nP += 1
                    string r = str.tostring(nP)
                    if not isSecond and sane(rp)
                        array.push(zP, rp)
                    drawLevel(rp, "P" + r + "|Put level #" + r, tag, color.new(cNeg, tr), wRank, nP <= 2 ? lnStyle(styRank) : line.style_dotted, stren,
                         (nP == 1 ? "most negative net GEX: the main put-side concentration. Below it dealer hedging can speed up selling" : ordinal(nP) + " most negative net GEX") + shTxt, "🔴")
                else if kind == "A" and nA < rankA
                    nA += 1
                    string r = str.tostring(nA)
                    drawLevel(rp, "Ab" + r + "|Absolute GEX #" + r, tag, color.new(cAG, tr), wRank, nA <= 2 ? lnStyle(styRank) : line.style_dotted, stren,
                         (nA == 1 ? "greatest total gamma exposure (call + put GEX combined): often a magnet" : ordinal(nA) + " highest total gamma exposure") + shTxt, "🟣")
    if nConc > 0 and s.lv != ""
        int shown = 0
        for item in str.split(s.lv, ",")
            parts = str.split(item, ":")
            if array.size(parts) == 3 and shown < nConc
                float sp = str.tonumber(array.get(parts, 0))
                float sh = str.tonumber(array.get(parts, 2))
                bool  isPos = array.get(parts, 1) == "+"
                if not na(sp) and not na(sh) and sh * 100.0 >= minShare
                    drawLevel(mapP(sp, f, o), (isPos ? "+G " : "-G ") + str.tostring(sh * 100.0, "#") + "%", tag,
                         color.new(isPos ? cPos : cNeg, tr + 35), wMax, lnStyle(styMax))
                    shown += 1
    true

drawMore(Snap s, float f, float o, bool isSecond) =>
    string tag = tagOf(s)
    int tr = isSecond ? 40 : 0
    if show0 and s.x0 != ""
        string d0 = s.x0 == "0DTE" ? "0D" : s.x0
        drawLevel(mapP(s.z0, f, o), nm(d0 + " ZG", s.x0 + " zero gamma"), tag, color.new(cZG, tr + 25), w0, line.style_dashed, na, "this expiry's gamma flip (estimate): where the gamma zones change sign", "🟡")
        drawLevel(mapP(s.c0, f, o), nm(d0 + " CW", s.x0 + " call wall"), tag, color.new(cPos, tr + 25), w0, lnStyle(sty0), na, "the strike above price with the most call gamma in this expiry", "🟢")
        drawLevel(mapP(s.p0, f, o), nm(d0 + " PW", s.x0 + " put wall"), tag, color.new(cNeg, tr + 25), w0, lnStyle(sty0), na, "the strike below price with the most put gamma in this expiry", "🔴")
    if showVol
        drawLevel(mapP(s.vc, f, o), nm("VOL C", "Volume call wall"), tag, color.new(cVol, tr), wVol, lnStyle(styVol))
        drawLevel(mapP(s.vp, f, o), nm("VOL P", "Volume put wall"), tag, color.new(cVol, tr), wVol, lnStyle(styVol))
    if showOI
        drawLevel(mapP(s.oc, f, o), nm("OI C", "OI call wall"), tag, color.new(cOI, tr), wOI, lnStyle(styOI))
        drawLevel(mapP(s.op, f, o), nm("OI P", "OI put wall"), tag, color.new(cOI, tr), wOI, lnStyle(styOI))
    if showMP and s.xp != ""
        int k = 0
        for item in str.split(s.xp, ",")
            parts = str.split(item, ":")
            if array.size(parts) == 2 and (k == 0 or mpCount == "Nearest + next")
                string d = str.substring(array.get(parts, 0), 5)
                drawLevel(mapP(str.tonumber(array.get(parts, 1)), f, o), nm("MP " + d, "Max pain " + d), tag, color.new(cMP, tr), wMP, lnStyle(styMP))
            k += 1
    if showEM and not na(s.ema)
        if emMode != "Weekly" and not na(s.emd)
            drawLevel(mapP(s.ema + s.emd, f, o), nm("EM+", "Expected high today"), tag, color.new(cEM, tr), wEM, lnStyle(styEM))
            drawLevel(mapP(s.ema - s.emd, f, o), nm("EM-", "Expected low today"), tag, color.new(cEM, tr), wEM, lnStyle(styEM))
            float bandHi = mapP(s.ema + s.emd, f, o)
            float bandLo = mapP(s.ema - s.emd, f, o)
            if emFill and not isSecond and not na(bandHi) and not na(bandLo) and sane(bandHi) and sane(bandLo)
                array.push(gBoxes, box.new(math.min(sessStartTime, time - 1), bandHi, time, bandLo, xloc = xloc.bar_time,
                     extend = extend.right, border_width = 0, border_color = color.new(cEM, 100), bgcolor = color.new(cEM, 92)))
        if emMode != "Daily" and not na(s.emw)
            drawLevel(mapP(s.ema + s.emw, f, o), nm("EMw+", "Expected high this week"), tag, color.new(cEM, tr + 25), wEM, lnStyle(styEM))
            drawLevel(mapP(s.ema - s.emw, f, o), nm("EMw-", "Expected low this week"), tag, color.new(cEM, tr + 25), wEM, lnStyle(styEM))
    true

// GEX profile: "base/width/v1,v2,..." with v in -99..99; bin i is centred at base + i*width (index prices).
drawProfile(Snap s, float f, float o) =>
    parts = str.split(s.prof, "/")
    if array.size(parts) == 3 and not na(f)
        float base = str.tonumber(array.get(parts, 0))
        float w = str.tonumber(array.get(parts, 1))
        array<string> vals = str.split(array.get(parts, 2), ",")
        int half = math.round(profWidth / 2)
        int axisX = bar_index + profOffset + half
        int tr = 100 - profOpac
        if not na(base) and not na(w) and w > 0
            float lo = (base - w / 2) * f + o
            float hi = (base + (array.size(vals) - 0.5) * w) * f + o
            array.push(gBoxes, box.new(axisX, hi, axisX, lo, border_color = color.new(cZG, 55), border_width = 1, bgcolor = color.new(cZG, 100)))
            for [i, v] in vals
                float val = str.tonumber(v)
                if not na(val) and val != 0
                    float c = (base + i * w) * f + o
                    float hh = w * f * 0.40
                    int len = math.max(1, math.round(math.abs(val) / 99.0 * half))
                    int x1 = val > 0 ? axisX : axisX - len
                    int x2 = val > 0 ? axisX + len : axisX
                    array.push(gBoxes, box.new(x1, c + hh, x2, c - hh, border_width = 0,
                         border_color = color.new(color.black, 100), bgcolor = color.new(val > 0 ? cPos : cNeg, tr)))
    true

// Gamma zones, measured from the gamma flip (zFlip) and the ranked call / put levels (zC, zP in rank order):
//   Positive Gamma Zone            flip .. C1         call-dominated gamma: dealer hedging dampens moves
//   Positive Gamma Extension Zone  C1 .. next C up    above C1: reduced hedging pressure
//   Negative Gamma Zone            P1 .. flip         put-dominated gamma: hedging adds to moves
//   Negative Gamma Extension Zone  next P down .. P1
// A zone whose bound is missing (or on the wrong side of the flip) is left out.
type Zone
    string name
    float lo
    float hi
    string about
    bool pos
    bool ext

nextAbove(array<float> a, float p) =>
    float best = na
    for q in a
        if q > p + syminfo.mintick / 2 and (na(best) or q < best)
            best := q
    best

nextBelow(array<float> a, float p) =>
    float best = na
    for q in a
        if q < p - syminfo.mintick / 2 and (na(best) or q > best)
            best := q
    best

zones() =>
    array<Zone> zs = array.new<Zone>()
    float c1 = array.size(zC) > 0 ? array.get(zC, 0) : na
    float p1 = array.size(zP) > 0 ? array.get(zP, 0) : na
    if not na(c1)
        if not na(zFlip) and c1 > zFlip
            array.push(zs, Zone.new("Positive Gamma Zone", zFlip, c1, "Call-dominated gamma: dealer hedging dampens moves. From the gamma flip up to C1.", true, false))
        float cx = nextAbove(zC, c1)
        if not na(cx)
            array.push(zs, Zone.new("Positive Gamma Extension Zone", c1, cx, "Above C1: reduced hedging pressure. Extends to the nearest call level above C1.", true, true))
    if not na(p1)
        if not na(zFlip) and p1 < zFlip
            array.push(zs, Zone.new("Negative Gamma Zone", p1, zFlip, "Put-dominated gamma: dealer hedging adds to moves. From P1 up to the gamma flip.", false, false))
        float px = nextBelow(zP, p1)
        if not na(px)
            array.push(zs, Zone.new("Negative Gamma Extension Zone", px, p1, "Below P1: hedging adds to selling. Extends to the nearest put level below P1.", false, true))
    zs

zoneTxt(array<Zone> zs, float p) =>
    float eps = syminfo.mintick / 2
    string inside = ""
    int nIn = 0
    bool edge = false
    for z in zs
        if p >= z.lo - eps and p <= z.hi + eps
            nIn += 1
            edge := edge or math.abs(p - z.lo) <= eps or math.abs(p - z.hi) <= eps
            inside += (inside == "" ? "" : "\n") + (z.pos ? "🟢 " : "🔴 ") + z.name + " (" + fmtPx(z.lo) + " - " + fmtPx(z.hi) + ")\n" + z.about
    string head = edge and nIn > 1 ? "🔗 This level (" + fmtPx(p) + ") is a boundary between two gamma zones.\n" : ""
    string outside = na(zFlip) ? "Outside the mapped zones." : "Outside the mapped zones, " + (p >= zFlip ? "above" : "below") + " the gamma flip (" + fmtPx(zFlip) + ")."
    nIn == 0 ? outside : head + inside

confWord(int n) =>
    n >= 4 ? "very strong confluence" : n == 3 ? "strong confluence" : "moderate confluence"

renderTags() =>
    Snap s = okA ? sA : sB
    float tol = close * confPct / 100.0
    array<Zone> zs = zones()
    string hdr = ""
    string foot = ""
    if not na(s)
        [rks, what, first, etfOnly] = rankedOf(s)
        string d = first and s.x0d != "" ? s.x0d : s.bk
        string md = str.length(d) >= 10 ? str.substring(d, 5, 7) + "/" + str.substring(d, 8, 10) : "-"
        string chain = etfOnly ? s.etf + " standalone" : s.src + (s.etf != "" ? " + " + s.etf : "")
        hdr := "🗓 " + md + " · " + chain + " · " + (first ? "first expiry " + s.x0 : "all expirations" + (str.length(s.bk) >= 10 ? " to " + str.substring(s.bk, str.length(s.bk) - 5) : ""))
        float a = ageOf(s)
        string ageS = na(a) ? "?" : a < 60 ? str.tostring(math.round(a)) + "m" : str.tostring(math.floor(a / 60)) + "h " + str.tostring(math.round(a % 60)) + "m"
        foot := "⏳ Updated " + ageS + " ago " + (staleOf(s) ? "⚠ STALE: copy a fresh paste from the GEX PRO website." : "✓")
             + "\nRegime: " + (s.reg == "POS" ? "positive" : s.reg == "NEG" ? "negative" : "mixed") + " gamma, net " + (s.net >= 0 ? "+$" : "-$") + str.tostring(math.abs(s.net), "0.00") + "B per 1% move."
             + "\n" + s.prov + " " + s.src + (s.etf != "" ? "+" + s.etf : "") + " options, 15-min delayed. The website publishes a new paste every hour; paste it again for fresher levels."
    string rule = "\n━━━━━━━━━━━━━━━━━━━━\n"
    for [i, p] in tgP
        // confluence: every tag at this price plus the tags within the tolerance
        int nConf = array.size(str.split(array.get(tgName, i), "·"))
        string near = ""
        for [j, q] in tgP
            if j != i and math.abs(q - p) <= tol
                nConf += array.size(str.split(array.get(tgName, j), "·"))
                near += "\n" + array.get(tgFull, j)
        float dlt = p - close
        string where = (dlt >= 0 ? "▲ " : "▼ ") + str.tostring(math.abs(dlt) / close * 100, "0.00") + "% " + (dlt >= 0 ? "above" : "below") + " price, " + (dlt >= 0 ? "+" : "-") + str.tostring(math.abs(dlt), "#,##0.00") + " pts"
        string tip = hdr + rule + "📍 " + fmtPx(p) + " LEVEL ANALYSIS (" + where + ")" + rule
             + (nConf > 1 ? "🔗 Confluence " + str.repeat("●", math.min(nConf, 5)) + "\n" + str.tostring(nConf) + " levels converge: " + confWord(nConf) + ". Potential reaction zone.\n" : "")
             + array.get(tgFull, i) + near
             + rule + "🧭 ZONE CONTEXT" + rule + zoneTxt(zs, p)
             + (foot != "" ? rule + foot : "")
        if extent == "Across the chart, end at price"
            // the price sits ON TOP of the line where it ends (anchored by its bottom-right corner), plain digits like a
            // price-scale mark: 29885, 29914.75
            array.push(gLabels, label.new(bar_index, p, str.tostring(p, "#.##"), style = label.style_label_lower_right, color = color.new(#0b0e13, 100),
                 textcolor = color.new(array.get(tgCol, i), 5), size = size.small, textalign = text.align_right, tooltip = tip))
        float st = array.get(tgStr, i)
        color lc = array.get(tgCol, i)
        if not na(st)
            int tp = math.round((1 - math.min(1.0, st)) * 75)
            line.set_color(array.get(gLines, i), color.new(lc, tp))
            lc := color.new(lc, math.min(tp, 40))
        string blk = na(st) ? "" : str.repeat("▬", math.max(1, math.round(st * 12))) + "  "      // one continuous strength bar
        array.push(gLabels, label.new(bar_index + lblX, p, blk + str.replace_all(array.get(tgName, i), "·", "  ") + (nConf > 1 ? "  " + str.repeat("●", math.min(nConf, 5)) : ""),
             style = label.style_label_left, color = color.new(#0b0e13, 100), textcolor = lc, size = lSz,
             textalign = text.align_left, tooltip = tip))
    // the zones as a narrow column just right of the last bar (extensions fainter)
    if zoneShade
        for z in zs
            color zc = color.new(z.pos ? cPos : cNeg, z.ext ? 91 : 82)
            array.push(gBoxes, box.new(bar_index + 1, z.hi, bar_index + math.max(2, lblX - 1), z.lo, border_width = 0,
                 border_color = color.new(zc, 100), bgcolor = zc))
    true

bool extB = extFrom == "Both sources"
if barstate.islast
    clearAll()
    if okA
        drawKey(sA, facA, offA, false)
        drawMore(sA, facA, offA, false)
    if okB
        drawKey(sB, facB, offB, true)
        if extB or not okA
            drawMore(sB, facB, offB, true)
    if showProf
        if profSrc == "Second source" and okB
            drawProfile(sB, facB, offB)
        else if okA
            drawProfile(sA, facA, offA)
        else if okB
            drawProfile(sB, facB, offB)
    if manualTxt != ""
        for item in str.split(manualTxt, ",")
            parts = str.split(str.trim(item), ":")
            float mpx = array.size(parts) >= 1 ? str.tonumber(array.get(parts, 0)) : na
            string mname = array.size(parts) >= 2 ? str.trim(array.get(parts, 1)) : "Manual"
            drawLevel(mpx, mname, " (MAN)", color.new(color.silver, 0), 1, line.style_dashed)
    // the gamma flip the zones are measured from: the first expiry's when its levels are ranked, else all expiries'
    if okA or okB
        Snap sz = okA ? sA : sB
        float fz = okA ? facA : facB
        float oz = okA ? offA : offB
        [rz, wz, firstZ, ez] = rankedOf(sz)
        zFlip := firstZ and not na(sz.z0) ? mapP(sz.z0, fz, oz) : mapP(sz.zg, fz, oz)
    if tagMode
        renderTags()

// =====================================================================================================
// Info panel: a row per item, a column per source. Hidden entirely when "Show panel" is off.
// =====================================================================================================
tPos = tabPos == "Top right" ? position.top_right : tabPos == "Top left" ? position.top_left : tabPos == "Bottom right" ? position.bottom_right : position.bottom_left
tSz  = tabSize == "Tiny" ? size.tiny : tabSize == "Small" ? size.small : size.normal
var table tab = showTab ? table.new(tPos, 3, 18, bgcolor = color.new(#0b0e13, 12), frame_color = color.new(#2a313c, 0), frame_width = 1, border_width = 0) : table(na)
cTxt  = color.new(#e3e7ee, 0)
cDim  = color.new(#7d8796, 0)
cWarn = color.new(#e6c35c, 0)
cHead = color.new(#171c25, 0)

ps(float p) =>
    na(p) ? "-" : fmtPx(p)

// price plus signed distance from the last close in points, e.g. "29,883.25  +186"
lvl(float p) =>
    na(p) ? "-" : fmtPx(p) + "  " + (p >= close ? "+" : "-") + str.tostring(math.abs(p - close), "#.##")

ageTxt(float a) =>
    na(a) ? "?" : a < 60 ? str.tostring(math.round(a)) + "m" : str.tostring(math.floor(a / 60)) + "h" + str.tostring(math.round(a % 60)) + "m"

mpFirst(Snap s, float f, float o) =>
    string out = "-"
    if s.xp != ""
        parts = str.split(array.get(str.split(s.xp, ","), 0), ":")
        if array.size(parts) == 2
            out := ps(mapP(str.tonumber(array.get(parts, 1)), f, o)) + "  " + str.substring(array.get(parts, 0), 5)
    out

// panel header, e.g. "CBOE SPX+SPY": provider, index options, and the ETF options folded into them
srcTxt(Snap s) =>
    s.prov + " " + s.src + (s.etf != "" ? "+" + s.etf : "")

cell(int c, int r, string t, color col, color bg = na) =>
    table.cell(tab, c, r, t, text_color = col, text_halign = c == 0 ? text.align_left : text.align_right, text_size = tSz, bgcolor = bg)

rowKeys = tabDetail == "Minimal" ? array.from("reg", "zg", "data") : tabDetail == "Compact" ? array.from("reg", "zg", "cw", "pw", "data")
     : array.from("reg", "net", "hedge", "charm", "zg", "cw", "pw", "ag", "mx", "x0", "vol", "mp", "em", "map", "data")

rowName(string k) =>
    switch k
        "reg"  => "Regime"
        "net"  => "Net GEX"
        "zg"   => "Zero gamma"
        "cw"   => "Call wall"
        "pw"   => "Put wall"
        "mx"   => "+GEX / -GEX"
        "x0"   => (hasA and sA.x0 != "" ? sA.x0 : "0DTE") + " ZG/CW/PW"
        "vol"  => "Vol walls C/P"
        "mp"   => "Max pain"
        "em"   => "Exp. move"
        "ag"   => "Abs gamma"
        "hedge" => "Hedge per 1%"
        "charm" => "Charm flow"
        "map"  => "Mapping"
        "data" => "Data"
        => k

valOf(string k, Snap s, float f, float o, bool ok, string mst) =>
    string t = "-"
    color c = cTxt
    if k == "data"
        bool bad = staleOf(s) or not s.complete or (s.st != "OK" and s.st != "")
        t := (s.q == "RT" ? "RT " : s.q == "SYN" ? "SYN " : "DL ") + ageTxt(ageOf(s)) + (staleOf(s) ? " STALE" : "") + (s.complete ? "" : " CUT OFF") + (s.st != "OK" and s.st != "" ? " " + s.st : "")
        c := bad ? cWarn : cDim
    else if not ok
        t := k == "reg" ? "BLOCKED" : "-"
        c := k == "reg" ? cWarn : cDim
    else
        switch k
            "reg" =>
                t := s.reg == "POS" ? "+ Positive" : s.reg == "NEG" ? "- Negative" : s.reg == "IND" ? "~ Balanced" : "-"
                t := t + (s.preg != "" and s.preg != s.reg ? " (new)" : "")
                c := s.reg == "POS" ? cPos : s.reg == "NEG" ? cNeg : cTxt
            "net" =>
                t := na(s.net) ? "-" : (s.net >= 0 ? "+" : "") + str.tostring(s.net, "#.#") + "B"
                c := na(s.net) ? cTxt : s.net >= 0 ? cPos : cNeg
            "zg" =>
                float zp = mapP(s.zg, f, o)
                t := s.zgs == "X" ? "none nearby" : lvl(zp)
                // distance in daily expected moves: under ~0.3 means price is right at the flip
                if not na(zp) and not na(s.emd) and not na(f) and s.emd > 0
                    t := t + "  (" + str.tostring(math.abs(close - zp) / (s.emd * f), "#.0") + "σ)"
                c := cZG
            "ag" =>
                t := lvl(mapP(s.ag, f, o))
                c := cAG
            "hedge" =>
                // dollars of dealer hedging per 1% move, as contracts of THIS chart (NQ, MNQ, ES or MES)
                if not na(s.net)
                    float n = s.net * 1e9 / (close * syminfo.pointvalue)
                    t := str.tostring(math.abs(n), "#,###") + " " + syminfo.root + (s.net >= 0 ? " dampening" : " amplifying")
                    c := s.net >= 0 ? cPos : cNeg
            "charm" =>
                // time decay shifts dealer delta by chm $M/day; staying hedged means trading the opposite way
                if not na(s.chm)
                    float n = -s.chm * 1e6 / (close * syminfo.pointvalue)
                    t := (n >= 0 ? "buy " : "sell ") + str.tostring(math.abs(n), "#,###") + " " + syminfo.root + "/day"
                    c := n >= 0 ? cPos : cNeg
            "cw" =>
                t := lvl(mapP(s.cw, f, o))
                c := cPos
            "pw" =>
                t := lvl(mapP(s.pw, f, o))
                c := cNeg
            "mx" =>
                t := ps(mapP(s.mp, f, o)) + " / " + ps(mapP(s.mn, f, o))
            "x0" =>
                t := ps(mapP(s.z0, f, o)) + " / " + ps(mapP(s.c0, f, o)) + " / " + ps(mapP(s.p0, f, o))
            "vol" =>
                t := ps(mapP(s.vc, f, o)) + " / " + ps(mapP(s.vp, f, o))
                c := cVol
            "mp" =>
                t := mpFirst(s, f, o)
                c := cMP
            "em" =>
                t := na(s.emd) or na(f) ? "-" : "+/-" + str.tostring(s.emd * f, "#") + (na(s.emw) ? "" : "  wk +/-" + str.tostring(s.emw * f, "#"))
            "map" =>
                t := mst
                c := na(f) ? cWarn : cDim
    [t, c]

if showTab and barstate.islast
    table.clear(tab, 0, 0, 2, 17)
    if not hasA
        cell(0, 0, "GEX PRO", cDim, cHead)
        cell(1, 0, nParsed == 0 ? "no payload" : "no " + chartFam + " payload", cWarn, cHead)
        cell(0, 1, nParsed == 0 ? "Copy from 127.0.0.1:8765" : "Pasted: " + otherMkts, cDim)
    else
        cell(0, 0, syminfo.ticker, cDim, cHead)
        cell(1, 0, srcTxt(sA), cTxt, cHead)
        if hasB
            cell(2, 0, srcTxt(sB), cTxt, cHead)
        for [i, k] in rowKeys
            cell(0, i + 1, rowName(k), cDim)
            [t1, c1] = valOf(k, sA, facA, offA, okA, mstA)
            cell(1, i + 1, t1, c1)
            if hasB
                [t2, c2] = valOf(k, sB, facB, offB, okB, mstB)
                cell(2, i + 1, t2, c2)

// =====================================================================================================
// Alerts (real-time only, per-type cooldown) on the first drawable source.
// Level shifts / regime changes between updates are alerted by the gexsys service instead.
// =====================================================================================================
var int lastAp = 0
var int lastCr = 0
var int lastZg = 0
var int lastSt = 0
cool(int last) =>
    timenow - last >= alCooldownMin * 60000

canDraw = okA or okB

// Optional tint of today's session: above zero gamma = modeled positive gamma, below = negative
bgcolor(regimeBg and canDraw and time >= sessStartTime and not na(zgF) ? (close >= zgF ? color.new(cPos, 93) : color.new(cNeg, 93)) : na,
     title = "Gamma side tint", editable = false)
nearest = na(cwF) and na(pwF) and na(zgF) ? na : array.min(array.from(nz(math.abs(close - cwF), 1e12), nz(math.abs(close - pwF), 1e12), nz(math.abs(close - zgF), 1e12)))
// ta.cross must run on every bar (v6 `and` is lazy), so evaluate first and combine afterwards
xCW = ta.cross(close, cwF)
xPW = ta.cross(close, pwF)
xZG = ta.cross(close, zgF)
crossedMajor = canDraw and (xCW or xPW)
crossedZG    = canDraw and xZG
approaching  = canDraw and not na(nearest) and nearest <= alApproachTicks * syminfo.mintick and nz(nearest[1], 1e12) > alApproachTicks * syminfo.mintick
anyStale     = (hasA and staleOf(sA)) or (hasB and staleOf(sB))

if barstate.isrealtime
    if alApproach and approaching and cool(lastAp)
        alert(syminfo.ticker + " within " + str.tostring(alApproachTicks) + " ticks of a GEX level (call " + ps(cwF) + " / put " + ps(pwF) + " / ZG " + ps(zgF) + ").", alert.freq_once_per_bar)
        lastAp := timenow
    if alCross and crossedMajor and cool(lastCr)
        alert(syminfo.ticker + " crossed a GEX wall (call " + ps(cwF) + " / put " + ps(pwF) + ").", alert.freq_once_per_bar)
        lastCr := timenow
    if alZG and crossedZG and cool(lastZg)
        alert(syminfo.ticker + " crossed estimated zero gamma " + ps(zgF) + ".", alert.freq_once_per_bar)
        lastZg := timenow
    if alStale and anyStale and cool(lastSt)
        alert("GEX update for " + syminfo.ticker + " is stale - paste a fresh one from the website.", alert.freq_once_per_bar)
        lastSt := timenow

alertcondition(crossedZG, "GEX: zero-gamma cross", "{{ticker}} crossed the estimated zero-gamma level")
alertcondition(crossedMajor, "GEX: wall cross", "{{ticker}} crossed a GEX call or put wall")

// Current mapped levels in TradingView's Data Window. editable = false keeps them off the settings
// dialog's Style tab, so every visual setting lives on the Inputs tab.
plot(zgF, "Zero gamma (est.)", display = display.data_window, editable = false)
plot(cwF, "Call wall", display = display.data_window, editable = false)
plot(pwF, "Put wall", display = display.data_window, editable = false)
