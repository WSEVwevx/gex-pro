{
  "engine": {
    "positioning": "conventional",
    "unit": "usd_per_1pct",
    "include_0dte": true,
    "max_dte": 45,
    "grid_pct": 0.05,
    "grid_steps": 201
  },
  "levels": {
    "top_n": 6,
    "min_share": 0.04
  },
  "refresh": {
    "rth_seconds": 60,
    "eth_seconds": 900,
    "closed_seconds": 3600
  },
  "alerts": {
    "level_shift_ticks": 20,
    "cooldown_s": 900,
    "stale_after_s": 1800
  },
  "storage": {
    "root": "data/snapshots",
    "store_raw": false
  },
  "publish": {
    "times_et": [
      "09:45",
      "11:45",
      "13:45",
      "15:30"
    ],
    "desktop_notify": true,
    "webhook_format": "json"
  },
  "description": "ES/MES levels from SPY ETF options (proxy, ratio mapping only)",
  "market": "ES",
  "source": "SPY",
  "provider": {
    "name": "tradier",
    "requests_per_minute": 60
  },
  "mapping": {
    "method": "ratio",
    "max_skew_s": 60
  },
  "futures_ref": {
    "mode": "none"
  }
}
