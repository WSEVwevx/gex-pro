{
  "engine": {
    "positioning": "conventional",
    "unit": "usd_per_1pct",
    "include_0dte": true,
    "max_dte": 45,
    "grid_pct": 0.05,
    "grid_steps": 201,
    "recompute_greeks": "always",
    "max_spot_age_s": 1800
  },
  "levels": {
    "top_n": 6,
    "min_share": 0.04
  },
  "refresh": {
    "rth_seconds": 300,
    "eth_seconds": 1800,
    "closed_seconds": 3600
  },
  "alerts": {
    "level_shift_ticks": 20,
    "cooldown_s": 900,
    "stale_after_s": 2700
  },
  "storage": {
    "root": "%LOCALAPPDATA%/gexsys/snapshots",
    "store_raw": false
  },
  "publish": {
    "times_et": [
      "00:00",
      "01:00",
      "02:00",
      "03:00",
      "04:00",
      "05:00",
      "06:00",
      "07:00",
      "08:00",
      "09:00",
      "10:00",
      "11:00",
      "12:00",
      "13:00",
      "14:00",
      "15:00",
      "16:00",
      "17:00",
      "18:00",
      "19:00",
      "20:00",
      "21:00",
      "22:00",
      "23:00"
    ],
    "desktop_notify": true,
    "webhook_format": "json",
    "all_day": true
  },
  "mapping": {
    "method": "ratio",
    "max_skew_s": 60
  },
  "futures_ref": {
    "mode": "carry"
  },
  "description": "NQ levels from NDX + QQQ options (Cboe free feed, 15-min delayed), QQQ converted to NDX terms, mapped to NQ futures",
  "market": "NQ",
  "source": "NDX",
  "provider": {
    "name": "cboe",
    "include_etf": true
  }
}
