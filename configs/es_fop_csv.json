{
  "engine": {
    "positioning": "conventional",
    "unit": "usd_per_1pct",
    "include_0dte": true,
    "max_dte": 90,
    "grid_pct": 0.05,
    "grid_steps": 201
  },
  "levels": {
    "top_n": 6,
    "min_share": 0.04
  },
  "refresh": {
    "rth_seconds": 60,
    "eth_seconds": 900,
    "closed_seconds": 3600
  },
  "alerts": {
    "level_shift_ticks": 20,
    "cooldown_s": 900,
    "stale_after_s": 1800
  },
  "storage": {
    "root": "data/snapshots",
