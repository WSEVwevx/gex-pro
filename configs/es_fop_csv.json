  },
  "publish": {
    "times_et": [
      "09:45",
      "11:45",
      "13:45",
      "15:30"
    ],
    "desktop_notify": true,
    "webhook_format": "json"
  },
  "description": "ES levels from CME ES futures options via CSV export (sample file - replace path)",
  "market": "ES",
  "source": "ES_FOP",
  "provider": {
    "name": "csv",
    "path": "tests/data/es_fop_sample.csv",
    "quote_quality": "DL",
    "greeks_quality": "PROV",
    "spot_quality": "DL"
  },
  "mapping": {
    "method": "identity"
  }
