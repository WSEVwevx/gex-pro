# Copy to .env and fill in. Never commit .env.

# --- Tradier (SPX/SPXW, NDX/NDXP, SPY, QQQ options) ---
TRADIER_TOKEN=replace-with-your-token
# Production: https://api.tradier.com/v1   Sandbox (delayed): https://sandbox.tradier.com/v1
TRADIER_BASE_URL=https://api.tradier.com/v1
# Declare what your account is entitled to: RT (real-time) or DL (delayed). Sandbox is always DL.
TRADIER_QUOTE_QUALITY=DL

# --- Model assumptions ---
GEX_RISK_FREE_RATE=0.04
# Continuous dividend yield per source (used only when Greeks are recomputed / IV solved)
GEX_DIV_YIELD_SPX=0.013
GEX_DIV_YIELD_NDX=0.007
GEX_DIV_YIELD_SPY=0.013
GEX_DIV_YIELD_QQQ=0.006

# --- Optional alert webhook (receives JSON POSTs from the service) ---
GEX_ALERT_WEBHOOK_URL=
